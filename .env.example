# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_NAME=strategic-analysis-backend
APP_ENV=development
APP_DEBUG=false
HOST=0.0.0.0
PORT=8000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Retry policy
RETRY_MAX_ATTEMPTS=5
RETRY_MIN_WAIT_SECONDS=1
RETRY_MAX_WAIT_SECONDS=15
RETRY_MULTIPLIER=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
# Google AI Mode Switch
# "google_overview" → Direct Google Overview scraper
# "new_ai_mode"     → Job polling New AI Mode scraper (DEFAULT)
# ──────────────────────────────────────────────
GOOGLE_AI_MODE=new_ai_mode

# ──────────────────────────────────────────────
# Scraper URLs — All 3 endpoints
# ──────────────────────────────────────────────
SCRAPER_URL_PERPLEXITY=https://perplexity-scraper-new-production.up.railway.app/scrape
SCRAPER_URL_GOOGLE_OVERVIEW=https://google-ai-overview-scraper-production.up.railway.app/scrape
SCRAPER_URL_NEW_AI_MODE=https://discerning-dream-production-a744.up.railway.app/api/v1/scrape

# Shared scraper settings
SCRAPER_API_KEY=
SCRAPER_POLL_INITIAL_INTERVAL=3.0
SCRAPER_POLL_MAX_INTERVAL=3.0
SCRAPER_POLL_BACKOFF_MULTIPLIER=1.0
SCRAPER_POLL_MAX_ATTEMPTS=100
SCRAPER_REQUEST_TIMEOUT=30.0
