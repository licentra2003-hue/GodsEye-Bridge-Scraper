# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_NAME=strategic-analysis-backend
APP_ENV=development
APP_DEBUG=false
HOST=0.0.0.0
PORT=8000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Retry policy
RETRY_MAX_ATTEMPTS=5
RETRY_MIN_WAIT_SECONDS=1
RETRY_MAX_WAIT_SECONDS=15
RETRY_MULTIPLIER=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
# Google AI Mode Switch
# "google_overview" → Direct Google Overview scraper
# "new_ai_mode"     → Job polling New AI Mode scraper (DEFAULT)
# ──────────────────────────────────────────────
GOOGLE_AI_MODE=new_ai_mode

# ──────────────────────────────────────────────
# LLM Analysis Bypass Switch
# false (default) → full pipeline: scrape → Gemini analysis → store
# true            → scrape-only:   scrape → store raw data (no Gemini call)
# ──────────────────────────────────────────────
SKIP_LLM_ANALYSIS=false

# ──────────────────────────────────────────────
# Scraper URLs — All 3 endpoints
# ──────────────────────────────────────────────
SCRAPER_URL_PERPLEXITY=
SCRAPER_URL_GOOGLE_OVERVIEW=
SCRAPER_URL_NEW_AI_MODE=

# Shared scraper settings
SCRAPER_API_KEY=
SCRAPER_POLL_INITIAL_INTERVAL=5.0
SCRAPER_POLL_MAX_INTERVAL=10.0
SCRAPER_POLL_BACKOFF_MULTIPLIER=1.5
SCRAPER_POLL_MAX_ATTEMPTS=500
SCRAPER_REQUEST_TIMEOUT=300.0

# ──────────────────────────────────────────────
# Per-pipeline concurrency limits
# Controls how many scraper requests run simultaneously.
# Perplexity: browser-based, memory-intensive  → lower limit
# Google / ChatGPT: job-queue based, lighter   → higher limit
# ──────────────────────────────────────────────
PERPLEXITY_CONCURRENCY_LIMIT=10
GOOGLE_CONCURRENCY_LIMIT=20
